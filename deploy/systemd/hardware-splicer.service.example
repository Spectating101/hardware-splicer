[Unit]
Description=Hardware-Splicer API and UI
After=network.target

[Service]
Type=simple
User=hsplicer
WorkingDirectory=/opt/hardware-splicer
Environment=PYTHONPATH=/opt/hardware-splicer/src
Environment=HARDWARE_SPLICER_AUTOROUTE=0
Environment=HARDWARE_SPLICER_DRC_FIX_LOOP=1
Environment=HARDWARE_SPLICER_TMP_ROOT=/var/lib/hardware-splicer/builds
# Job database, projects and outputs; the checkout default (.cache/ under /opt) is not for services.
Environment=HARDWARE_SPLICER_STATE_DIR=/var/lib/hardware-splicer/state
# The one served app (API + UI). Run make ui-package after UI upgrades; --ui refuses to start without a build.
ExecStart=/opt/hardware-splicer/.venv/bin/hs-serve --ui --host 127.0.0.1 --port 8787
Restart=on-failure

[Install]
WantedBy=multi-user.target
