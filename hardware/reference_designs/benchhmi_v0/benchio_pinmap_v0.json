  "clock_policy": {
    "external_crystal_required": false,
    "initial_plan": "internal clocking; USB clock configuration must be verified against STM32G0B1 USB requirements before firmware release"
  },
  "invariants": [
    "PA11/PA12 are reserved for USB and may not be reused for FDCAN1.",
    "PA13/PA14 remain SWDIO/SWCLK and may not be consumed by UARTs.",
    "FDCAN2 uses PB5/PB6, not PA11/PA12.",
    "USART2 uses PA1/PA2/PA3 for DE/TX/RX.",
    "USART3 uses PB1/PB10/PB11 for DE/TX/RX.",
    "all signal assignments use unique LQFP48 physical pins",
    "DO0-DO3 are four independent host GPIO outputs feeding ISO6740 inputs"
  ],
